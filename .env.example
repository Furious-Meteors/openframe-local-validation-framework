# Postgres
DATABASE_URL=postgresql://openframe:openframe@localhost:5432/openframe
POOL_SIZE=5

# MongoDB
MONGO_URL=mongodb://openframe:openframe@localhost:27017/?authSource=admin
MONGO_DATABASE=openframe

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=openframe
REDIS_DEFAULT_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=openframe-events
KAFKA_GROUP_ID=openframe-validation

# OTel (optional — no-op if not set)
OTEL_SERVICE_NAME=openframe-validation
OPENFRAME_ENV=dev

# Swap demo
PERSISTENCE_BACKEND=postgres   # or: mongo
